{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["node", "jest", "@testing-library/jest-dom", "vite/client"]
  },
  "include": [
    "src/**/*.test.tsx",
    "src/**/*.test.ts", 
    "src/setupTests.ts",
    "src/__mocks__/**/*",
    "src/config/**/*" 
  ]
}